# Copie para .env e preencha com os valores reais. O .env nunca é commitado.

# --- Banco ---
# Postgres do Supabase — usar a string do Session Pooler (IPv4).
# A conexão direta (IPv6) costuma falhar em redes domésticas brasileiras.
# Supabase > Project Settings > Database > Connection string > Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Postgres descartável usado só pelos testes de banco. Sem esta variável, os
# testes que tocam o banco são pulados — nunca aponte para o banco do projeto,
# porque a suíte cria e apaga tabelas.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lgpd_test

# --- Supabase Auth ---
# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_<...>
# Chave de serviço: ignora RLS. Nunca expor no frontend.
SUPABASE_SECRET_KEY=sb_secret_<...>
# O projeto assina JWT com chave assimétrica (ECC P-256), então a validação é
# feita pelo JWKS público e não por segredo compartilhado — assim a rotação de
# chave no Supabase não quebra a API.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por
# vírgula. Em produção, trocar pela URL real do frontend — o default cobre
# só o Vite em dev.
CORS_ORIGINS=http://localhost:5173

# --- Fila de scans (opcional) ---
# Vazio: scans rodam via BackgroundTasks do FastAPI (ok para dev sem Docker).
# Preenchido: scans vão para RQ, e é preciso rodar `python -m app.worker` à
# parte para eles serem processados. Redis descartável local:
#   docker run -d --name lgpd-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0
# Banco Redis separado (mesmo container, índice diferente) para os testes de
# fila não colidirem com um worker de dev rodando ao mesmo tempo.
TEST_REDIS_URL=redis://localhost:6379/1

# --- IA ---
# Qual adaptador de app/services/ai_provider.py usar: gemini | anthropic | fake
AI_PROVIDER=gemini
# Google AI Studio > Get API key (tier gratuito, sem cartão)
GEMINI_API_KEY=AIza<...>
# Preenchida só na fase paga, quando migrar para o Claude
ANTHROPIC_API_KEY=

# --- Observabilidade (opcional) ---
# Vazio: roda sem monitoramento nenhum, como hoje. Sentry > Project Settings > Client Keys
SENTRY_DSN=
# development | staging | production — aparece nos eventos do Sentry
ENVIRONMENT=development
